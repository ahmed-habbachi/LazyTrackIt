// Windows resources for lazytrackit-gui.exe: the icon Explorer and the
// taskbar show, the manifest (per-monitor DPI, common controls v6), and the
// version details in the file's Properties. gen-syso.sh fills in @...@.
1 ICON "lazytrackit.ico"
1 24 "app.manifest"

1 VERSIONINFO
FILEVERSION @NUMVER@
PRODUCTVERSION @NUMVER@
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "LazyTrackIt"
      VALUE "FileDescription", "LazyTrackIt"
      VALUE "FileVersion", "@VERSION@"
      VALUE "InternalName", "lazytrackit-gui"
      VALUE "OriginalFilename", "lazytrackit-gui.exe"
      VALUE "ProductName", "LazyTrackIt"
      VALUE "ProductVersion", "@VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
